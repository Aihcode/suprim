# ---------------------------------------------------------------------------
# PrintFlow ERP — copiar a .env  (cp .env.example .env)
# SQLite por defecto: arranque inmediato sin servicios externos.
# ---------------------------------------------------------------------------

# Motor de base de datos (Prisma). Ejemplos:
#   SQLite:      file:./dev.db
#   PostgreSQL:  postgresql://user:pass@localhost:5432/printflow
#   MySQL:       mysql://user:pass@localhost:3306/printflow
#   SQL Server:  sqlserver://localhost:1433;database=printflow;user=sa;password=...
DATABASE_URL="file:./dev.db"

# URL pública/base del backend (usada por webhooks y links de pago)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Autenticación
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-este-secreto-en-produccion"
JWT_SECRET="cambia-este-jwt-secret-en-produccion"

# Cifrado AES-256-GCM de archivos temporales (64 hex = 32 bytes)
FILE_ENCRYPTION_KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

# Almacenamiento local de archivos cifrados
UPLOAD_DIR="./uploads"

# Stripe (dejar vacío para usar el modo DEMO de pago local)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal (dejar vacío para usar el modo DEMO de pago local)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MODE="sandbox"

# Modo demo de pago (solo desarrollo). Nunca=true en producción.
DEMO_PAYMENTS="true"

# Tiempo real
SOCKET_IO_PATH="/socket.io"
STATION_OFFLINE_AFTER_MS=90000

# ---------------------------------------------------------------------------
# LogRocket (observabilidad del frontend) — OPCIONAL
# Déjalo vacío para desactivar la integración por completo (no se carga el SDK).
# El App ID tiene formato "empresa/aplicacion" (p. ej. "abc12/printflow-web").
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LOGROCKET_APP_ID=""
NEXT_PUBLIC_LOGROCKET_RELEASE="dev"
NEXT_PUBLIC_LOGROCKET_CDN="https://cdn.logrocket.io/LogRocket.min.js"
