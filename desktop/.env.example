# ---------------------------------------------------------------------------
# PrintBridge Desktop — copiar a desktop/.env
# Emparejar la estación desde Panel Admin → Estaciones (PrintBridge).
# ---------------------------------------------------------------------------

# Backend y WebSocket (Socket.io, namespace /station)
BACKEND_URL=http://localhost:3000
WS_URL=ws://localhost:3000/socket.io

# Credenciales de la estación (obligatorias fuera de DEMO)
STATION_ID=pc-01
STATION_TOKEN=pegue-aqui-el-jwt-generado-en-el-panel-admin
STATION_NAME=Imprenta PC-01

# Tipo de SO detectado automáticamente: WINDOWS | LINUX | MACOS
OS_TYPE=LINUX

# Modo DEMO: impresoras simuladas, backend opcional. NUNCA en producción.
DEMO_MODE=false

# Intervalos (segundos)
INTERVAL_TELEMETRY_S=30
POLL_INTERVAL_S=10

# Clave AES-256 para archivos temporales (64 hexadecimales = 32 bytes).
# Debe coincidir con FILE_ENCRYPTION_KEY del backend.
ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Secreto usado para verificar localmente el JWT HS256 de estación
# (normalmente JWT_SECRET / NEXTAUTH_SECRET del backend).
JWT_SECRET=cambia-este-jwt-secret-en-produccion

# Opcionales
COMPUTER_NAME=IMPRENTA-PC-01
LOG_LEVEL=INFO
LOG_FILE=printbridge.log
QUEUE_DB_PATH=local_queue.db
CACHE_DIR=.cache/jobs
MAX_CONCURRENT_JOBS=2
NETWORK_SCAN_ENABLED=true
NETWORK_SCAN_TIMEOUT=0.18
DISCOVERY_CACHE_S=300
