{
  "name": "printflow-erp",
  "version": "1.0.0",
  "private": true,
  "description": "PrintFlow ERP & PrintBridge Desktop - plataforma de impresión online con agente de escritorio",
  "scripts": {
    "dev": "node server.js",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm install && prisma generate && prisma db push && npm run db:seed",
    "lint": "next lint"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "dotenv": "16.4.7",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "next-auth": "4.24.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "stripe": "17.7.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
